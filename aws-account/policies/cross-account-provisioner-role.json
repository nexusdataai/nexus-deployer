{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowMasterAccountAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${MASTER_ACCOUNT_ID}:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "${EXTERNAL_ID}"
        }
      }
    }
  ]
}
