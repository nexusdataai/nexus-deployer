# Local K3s defaults for Nexus dev stack
# Source from this directory:  . ./.env.local.k3s
#
# Sets KUBECONFIG and switches kubectl to local-cluster (not EKS).

_LK3S_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export CLUSTER_NAME=local-cluster
export KUBECONFIG="${_LK3S_DIR}/../aws-login/.kube/config"
export LOCAL_AWS_ACCOUNT_ID=000000000000

kubectl config use-context "${CLUSTER_NAME}" --kubeconfig "${KUBECONFIG}" >/dev/null 2>&1 \
  || echo "warn: could not switch to context ${CLUSTER_NAME} (check KUBECONFIG=${KUBECONFIG})" >&2
